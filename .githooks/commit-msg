#!/usr/bin/env bash
# Biotrackr commit-msg: enforce docs/standards/commit-standards.md.
#
# Checks, in order:
#   1. Subject matches Conventional Commits with an approved type
#   2. Subject is at most 50 characters
#   3. Description starts lowercase, is imperative, and has no trailing period
#   4. Body lines are at most 72 characters
#   5. DCO Signed-off-by is present (bot accounts exempt)
#   6. AI trailers are all-or-none (agent, model, contribution)
#
# Bypass with: git commit --no-verify
# Disable for a session with: BIOTRACKR_SKIP_HOOKS=1

set -uo pipefail

MSG_FILE="${1:?commit-msg hook requires the message file path}"

[ "${BIOTRACKR_SKIP_HOOKS:-0}" = "1" ] && exit 0

STANDARD="docs/standards/commit-standards.md"

# git appends the diff after a scissors line when commit.verbose is on; drop it,
# then drop comment lines, so only the authored message is inspected.
BODY_TEXT="$(sed '/^# \{0,\}-\{5,\} >8 \{0,\}-\{5,\}/,$d' "$MSG_FILE" | grep -v '^#')"

SUBJECT="$(printf '%s\n' "$BODY_TEXT" | sed -n '1p')"

# Merge, revert, fixup and squash subjects are generated by git, not authored.
case "$SUBJECT" in
  Merge*|Revert*|fixup!*|squash!*|amend!*) exit 0 ;;
esac

FAILURES=0
report() {
  {
    echo ""
    echo "COMMIT-MSG FAILED: $1"
    shift
    for line in "$@"; do echo "  $line"; done
  } >&2
  FAILURES=$((FAILURES + 1))
}

# --- 1. Conventional Commits shape -------------------------------------------
if ! printf '%s' "$SUBJECT" | grep -qE '^(feat|fix|core|docs|refactor|test)(\([a-z0-9._-]+\))?: .+'; then
  report "the subject is not a valid Conventional Commit." \
    "got:      $SUBJECT" \
    "expected: <type>[(scope)]: <description>" \
    "types:    feat, fix, core, docs, refactor, test" \
    "scope:    lowercase alphanumeric with dashes, e.g. (activity-api)" \
    "example:  feat(vitals-api): add blood pressure validation" \
    "see:      $STANDARD"
else
  DESCRIPTION="${SUBJECT#*: }"

  # --- 3a. Lowercase after the colon ------------------------------------------
  if printf '%s' "$DESCRIPTION" | grep -qE '^[A-Z]'; then
    report "the description must start with a lowercase letter." \
      "got:      $DESCRIPTION" \
      "expected: add blood pressure validation" \
      "see:      $STANDARD"
  fi

  # --- 3b. No trailing period -------------------------------------------------
  case "$DESCRIPTION" in
    *.) report "the description must not end with a period." \
          "got:      $SUBJECT" \
          "see:      $STANDARD" ;;
  esac

  # --- 3c. Imperative mood (catches the common past/gerund/3rd-person forms) ---
  FIRST_WORD="$(printf '%s' "$DESCRIPTION" | cut -d' ' -f1 | tr '[:upper:]' '[:lower:]')"
  case "$FIRST_WORD" in
    added|updated|fixed|removed|changed|created|deleted|refactored|renamed|moved|implemented|improved|adds|updates|fixes|removes|changes|creates|deletes|adding|updating|fixing|removing|changing|creating|deleting)
      report "the description must use the imperative mood." \
        "got:      $FIRST_WORD ..." \
        "expected: add / update / fix / remove (not '$FIRST_WORD')" \
        "see:      $STANDARD"
      ;;
  esac
fi

# --- 2. Subject length --------------------------------------------------------
if [ "${#SUBJECT}" -gt 50 ]; then
  report "the subject is ${#SUBJECT} characters; the limit is 50." \
    "got:      $SUBJECT" \
    "next:     shorten the subject and move detail into the body." \
    "see:      $STANDARD"
fi

# --- 4. Body line length ------------------------------------------------------
LONG_BODY_LINES="$(printf '%s\n' "$BODY_TEXT" \
  | tail -n +2 \
  | grep -vE '^[A-Za-z][A-Za-z-]*: ' \
  | awk 'length($0) > 72 { print NR ": " $0 }' \
  | head -5)"
if [ -n "$LONG_BODY_LINES" ]; then
  report "one or more body lines exceed 72 characters." \
    "offending lines:" \
    "$LONG_BODY_LINES" \
    "see:      $STANDARD"
fi

# --- 5. DCO sign-off ----------------------------------------------------------
AUTHOR_IDENT="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)"
IS_BOT=0
case "$AUTHOR_IDENT" in
  *"github-actions[bot]"*|*"dependabot[bot]"*) IS_BOT=1 ;;
esac

if [ "$IS_BOT" -eq 0 ] && ! printf '%s\n' "$BODY_TEXT" | grep -qE '^Signed-off-by: .+ <.+>'; then
  report "the DCO sign-off is missing." \
    "expected: Signed-off-by: Your Name <you@example.com>" \
    "next:     commit with 'git commit -s', or amend with 'git commit --amend -s --no-edit'" \
    "note:     bot accounts (github-actions[bot], dependabot[bot]) are exempt." \
    "see:      $STANDARD"
fi

# --- 6. AI trailer consistency ------------------------------------------------
HAS_AGENT=0; HAS_MODEL=0; HAS_CONTRIBUTION=0
printf '%s\n' "$BODY_TEXT" | grep -qE '^agent: .+'        && HAS_AGENT=1
printf '%s\n' "$BODY_TEXT" | grep -qE '^model: .+'        && HAS_MODEL=1
printf '%s\n' "$BODY_TEXT" | grep -qE '^contribution: .+' && HAS_CONTRIBUTION=1

TRAILER_COUNT=$((HAS_AGENT + HAS_MODEL + HAS_CONTRIBUTION))
if [ "$TRAILER_COUNT" -gt 0 ] && [ "$TRAILER_COUNT" -lt 3 ]; then
  MISSING=""
  [ "$HAS_AGENT" -eq 0 ]        && MISSING="$MISSING agent"
  [ "$HAS_MODEL" -eq 0 ]        && MISSING="$MISSING model"
  [ "$HAS_CONTRIBUTION" -eq 0 ] && MISSING="$MISSING contribution"
  report "AI contribution trailers are incomplete." \
    "missing: ${MISSING# }" \
    "rule:    all three of agent, model, contribution are required together." \
    "example: --trailer \"agent: github-copilot\" --trailer \"model: Claude Sonnet 4.6\" --trailer \"contribution: code-generation\"" \
    "see:      $STANDARD"
fi

if [ "$FAILURES" -gt 0 ]; then
  {
    echo ""
    echo "COMMIT-MSG: $FAILURES rule(s) violated. The commit was not created."
    echo "  the message you wrote is preserved; re-run git commit to edit it."
    echo "  bypass (use sparingly): git commit --no-verify"
  } >&2
  exit 1
fi

exit 0
