#!/usr/bin/env bash
# Biotrackr pre-push: build, unit tests, and contract tests across the push range.
#
# Blocking by design. Bypass with: git push --no-verify
# Disable for a session with: BIOTRACKR_SKIP_HOOKS=1
#
# git supplies "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

BIOTRACKR_OBS_ROOT="$REPO_ROOT"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/observability.sh" 2>/dev/null || true
type -t emit_event >/dev/null 2>&1 || emit_event() { :; }
type -t obs_now_ms >/dev/null 2>&1 || obs_now_ms() { _OBS_NOW_MS=0; }

if [ "${BIOTRACKR_SKIP_HOOKS:-0}" = "1" ]; then
  emit_event pre-push gate range skip 0 "hooks-disabled" || true
  exit 0
fi

ZERO="0000000000000000000000000000000000000000"
STATUS=0
SAW_REF=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion — nothing to verify
  SAW_REF=1

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch on the remote: compare against the default branch when we can.
    if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
      range="origin/main..$local_sha"
    else
      range="$local_sha~1..$local_sha"
    fi
  else
    range="$remote_sha..$local_sha"
  fi

  obs_now_ms; _range_start="$_OBS_NOW_MS"
  if bash scripts/verify.sh --range "$range" --contract; then
    obs_now_ms
    emit_event pre-push verify-range "$range" pass $((_OBS_NOW_MS - _range_start)) || true
  else
    _rc=$?
    obs_now_ms
    if [ "$_rc" -eq 1 ]; then
      emit_event pre-push verify-range "$range" error $((_OBS_NOW_MS - _range_start)) "cannot-run" || true
    else
      emit_event pre-push verify-range "$range" fail $((_OBS_NOW_MS - _range_start)) "verify-rc-$_rc" || true
    fi
    STATUS=1
  fi
done

# Direct invocation (no stdin from git) — fall back to the working tree.
if [ "$SAW_REF" -eq 0 ]; then
  obs_now_ms; _wt_start="$_OBS_NOW_MS"
  if bash scripts/verify.sh --contract; then
    obs_now_ms
    emit_event pre-push verify-worktree working pass $((_OBS_NOW_MS - _wt_start)) || true
  else
    _rc=$?
    obs_now_ms
    # Same 1-vs-rest split as the ranged path above. Exit 1 means verify could
    # not run at all, which is a broken toolchain, not a broken change; folding
    # it into `fail` would report work that never happened as work that failed.
    if [ "$_rc" -eq 1 ]; then
      emit_event pre-push verify-worktree working error $((_OBS_NOW_MS - _wt_start)) "cannot-run" || true
    else
      emit_event pre-push verify-worktree working fail $((_OBS_NOW_MS - _wt_start)) "verify-rc-$_rc" || true
    fi
    STATUS=1
  fi
fi

if [ "$STATUS" -ne 0 ]; then
  emit_event pre-push gate range fail 0 || true
  {
    echo ""
    echo "PRE-PUSH FAILED: fix the failures above before pushing."
    echo "  next: reproduce with  bash scripts/verify.sh --contract"
    echo "  note: CI additionally enforces a 70% coverage threshold on top of this."
    echo "  bypass (use sparingly): git push --no-verify"
  } >&2
  exit 1
fi

emit_event pre-push gate range pass 0 || true

# Promotion runs here, on the success path, so raw records reach the committed
# rollup without anyone having to remember. It must never block a push: a
# failure to record measurements is not a reason to stop work, and the gate's
# 0/1 contract belongs to verification, not to telemetry.
if type -t promote_observability >/dev/null 2>&1; then
  if promote_observability; then
    # Promotion appends to a committed file, and nothing here commits it. Doing
    # so would fabricate a commit after the push range was already computed, so
    # it would not travel with this push anyway. Say so instead, rather than
    # letting the rollup drift silently out of the history it summarises.
    if [ "${_OBS_PROMOTED:-0}" -gt 0 ]; then
      echo "pre-push: promoted ${_OBS_PROMOTED} observability row(s) into .copilot-tracking/harness-evolution-metrics.md — commit it to publish them." >&2
    fi
  else
    echo "pre-push: promotion of observability records failed (push continues)." >&2
  fi
fi

exit 0
