{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/agent-post-edit.sh"],
            "async": true,
            "asyncRewake": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
